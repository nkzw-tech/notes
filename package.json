{
  "name": "notes-app",
  "version": "1.3.0",
  "private": true,
  "description": "A local-first Markdown notes app.",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/notes.git"
  },
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "build": "vp build",
    "check": "vp check",
    "dev": "vp dev --host 127.0.0.1",
    "dev:app": "vpr native:build && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "electron": "vpr native:build && electron .",
    "forge:make": "node scripts/electron-forge.cjs make",
    "forge:package": "node scripts/electron-forge.cjs package",
    "make": "vpr build && vpr forge:make",
    "make:linux": "vpr build && vpr forge:make --platform=linux --arch=x64",
    "make:mac": "vpr build && vpr forge:make --platform=darwin --arch=arm64",
    "make:windows": "vpr build && vpr forge:make --platform=win32 --arch=x64",
    "native:build": "node scripts/build-native.cjs",
    "package:app": "vp build && vpr forge:package",
    "prepare": "vp config",
    "preview": "vp preview --host 127.0.0.1",
    "start": "vpr build && vpr native:build && electron .",
    "test": "vp test",
    "test:soak": "electron scripts/persistence-soak.cjs",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "oxfmt": "0.67.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/mdx-editor": "1.0.3",
    "@nkzw/oxlint-config": "^2.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "diff": "9.0.0",
    "electron": "^44.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=23.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "build": {
    "appId": "dev.nkzw-tech.notes",
    "copyright": "Copyright © 2026-current Nakazawa Tech",
    "productName": "Notes"
  }
}
