{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Markdown notes app.",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/notes.git"
  },
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "dev:app": "ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "electron": "electron .",
    "make:mac": "pnpm build && node scripts/electron-forge.cjs make --platform=darwin --arch=arm64",
    "package:app": "pnpm build && node scripts/electron-forge.cjs package",
    "preview": "vite preview --host 127.0.0.1",
    "start": "pnpm build && electron .",
    "test": "vitest run",
    "test:soak": "electron scripts/persistence-soak.cjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "oxfmt": "0.67.0"
  },
  "engines": {
    "node": ">=23.0.0",
    "pnpm": ">=12.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@nkzw/mdx-editor": "1.0.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "diff": "9.0.0",
    "electron": "^44.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plus": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "build": {
    "appId": "dev.nkzw-tech.notes",
    "copyright": "Copyright © 2026-current Nakazawa Tech",
    "productName": "Notes"
  }
}
